    "@google/genai": "2.32.0",
    "@livingplus/shared": "file:../shared",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "14.5.1",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "11.5.3",
    "multer": "^2.1.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "^6.2.1",
    "sharp": "^0.35.2",
