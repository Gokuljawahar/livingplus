    "db": "tsx scripts/dev.ts --db-only",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "e2e:server": "tsx scripts/e2e-server.ts"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "tsx prisma/seed-pg.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
