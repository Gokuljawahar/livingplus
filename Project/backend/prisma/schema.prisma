generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  slug         String?  @unique
  email      String?  @unique
  phone      String?  @unique
  password   String
  name       String
  role       String   @default("PG_OWNER")
  profileImage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pgAccess   PGPropertyAccess[]
}

model PGProperty {
  id           String   @id @default(uuid())
  slug         String?  @unique
  name         String
  description  String?
  address      String
  locality     String
  contactPhone String?
  landmark     String?
  city         String   @default("Chennai")
  pincode      String?
  latitude     Float?
  longitude    Float?
  genderPolicy String   @default("ANY")
  amenities    Json     @default("[]")
  houseRules   Json     @default("[]")
  photoUrls    Json     @default("[]")
  status       String   @default("ACTIVE")
  bookingLockMinutes Int @default(120)
  rentDay      Int      @default(1)
  rentDueDay   Int      @default(5)
  upiId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms              PGRoom[]
  access             PGPropertyAccess[]
  bookings           PGBooking[]
  tenants            PGTenant[]
  auditLogs          PHAuditLog[]
  maintenanceTickets PGMaintenanceTicket[]
  expenses           PGExpense[]
  electricityBills   PGElectricityBill[]
  paymentClaims      PGPaymentClaim[]
  residentNotifications PGResidentNotification[]
  roomChangeRequests PGRoomChangeRequest[]
}

model PGPropertyAccess {
  id         String     @id @default(uuid())
  propertyId String
  userId     String
  role       String     @default("OWNER")
  createdAt  DateTime   @default(now())
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId, role])
}

model PGRoom {
  id                 String     @id @default(uuid())
  propertyId         String
  block              String?
  roomNumber         String
  floor              Int?
  roomType           String     @default("SHARED")
  monthlyRent        Float
  depositAmount      Float      @default(0)
  maintenanceFee     Float      @default(0)
  utilitiesSurcharge Float      @default(0)
  hasAc              Boolean    @default(false)
  foodIncluded       Boolean    @default(false)
  foodCharge         Float      @default(0)
  status             String     @default("ACTIVE")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  property           PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds               PGBed[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, status])
}

model PGBed {
  id              String   @id @default(uuid())
  roomId          String
  label           String
  status          String   @default("AVAILABLE")
  maintenanceNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  room            PGRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings        PGBooking[]
  tenants         PGTenant[]
  roomChangeFrom  PGRoomChangeRequest[] @relation("RoomChangeFromBed")
  roomChangeTo    PGRoomChangeRequest[] @relation("RoomChangeToBed")

  @@unique([roomId, label])
  @@index([roomId, status])
}

model PGBooking {
  id            String     @id @default(uuid())
  bookingRef    String?    @unique
  propertyId    String
  bedId         String?
  residentName  String
  phone         String
  email         String?
  moveInDate    DateTime
  moveOutDate   DateTime?
  lockExpiresAt DateTime?
  status        String     @default("PENDING")
  notes         String?
  rejectionReason String?
  idempotencyKey String? @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  property      PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bed           PGBed?     @relation(fields: [bedId], references: [id], onDelete: SetNull)
  tenant        PGTenant?

  @@index([propertyId, status, createdAt])
  @@index([bedId, status])
}

model PGTenant {
  id                    String       @id @default(uuid())
  propertyId            String
  bedId                 String?
  bookingId             String?      @unique
  name                  String
  phone                 String
  email                 String?
  permanentAddress      String?
  bloodGroup            String?
  institutionOrEmployer String?
  emergencyName         String?
  emergencyPhone        String?
  kycType               String?
  kycDocumentUrl        String?
  kycVerified           Boolean    @default(false)
  kycVerifiedAt         DateTime?
  foodOptOut            Boolean    @default(false)
  noticeDate            DateTime?
  moveInDate            DateTime
  moveOutDate           DateTime?
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  monthlyRent           Float
  depositAmount         Float        @default(0)
  depositReceived       Float        @default(0)
  depositDeductions     Float        @default(0)
  depositRefundAmount   Float?
  depositRefundStatus   String       @default("NOT_APPLICABLE")
  depositRefundReference String?
  depositRefundedAt     DateTime?
  checkoutNote          String?
  status                String       @default("RESERVED")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  property              PGProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bed                   PGBed?       @relation(fields: [bedId], references: [id], onDelete: SetNull)
  booking               PGBooking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rentEntries           PGRentEntry[]
  maintenanceTickets    PGMaintenanceTicket[]
  paymentClaims         PGPaymentClaim[]
  notifications         PGResidentNotification[]
  roomChangeRequests  PGRoomChangeRequest[] @relation("RoomChangeRequester")
  roomChangePartners  PGRoomChangeRequest[] @relation("RoomChangePartner")

  @@index([propertyId, status])
}

model PGRentEntry {
  id          String   @id @default(uuid())
  tenantId    String
  entryType   String   @default("RENT")
  period      String
  amount      Float
  paidAmount  Float    @default(0)
  dueDate     DateTime
  paidAt      DateTime?
  status      String   @default("DUE")
  reference   String?
  method      String?
  notes       String?
  invoiceCode String?  @unique
  lastReminderAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      PGTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentClaims PGPaymentClaim[]

  @@unique([tenantId, period, entryType])
  @@index([period, status])
}

model PGMaintenanceTicket {
  id          String     @id @default(uuid())
  propertyId  String
  bedId       String?
  tenantId    String?
  title       String
  description String
  category    String     @default("OTHER")
  priority    String     @default("NORMAL")
  status      String     @default("OPEN")
  imageUrl    String?
  assignedTo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  property    PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      PGTenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([propertyId, status, priority])
}

model PGPaymentClaim {
  id            String      @id @default(uuid())
  propertyId    String
  tenantId      String
  rentEntryId   String
  amount        Float
  reference     String
  status        String      @default("PENDING")
  reviewedBy    String?
  reviewedAt    DateTime?
  responseNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  property      PGProperty  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        PGTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentEntry     PGRentEntry @relation(fields: [rentEntryId], references: [id], onDelete: Cascade)

  @@unique([propertyId, reference])
  @@index([propertyId, status, createdAt])
  @@index([tenantId, status])
}

model PGResidentNotification {
  id         String     @id @default(uuid())
  propertyId String
  tenantId   String
  type       String
  title      String
  message    String
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime   @default(now())
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     PGTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt, createdAt])
  @@index([propertyId, type, createdAt])
}

model PGRoomChangeRequest {
  id            String   @id @default(uuid())
  propertyId    String
  requesterId   String
  requestType   String   @default("SWAP")
  fromBedId     String?
  toBedId       String?
  partnerId     String?
  preferences   String?
  reason        String?
  status        String   @default("PENDING_MATCH")
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  property      PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requester     PGTenant   @relation("RoomChangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  partner       PGTenant?  @relation("RoomChangePartner", fields: [partnerId], references: [id], onDelete: SetNull)
  fromBed       PGBed?     @relation("RoomChangeFromBed", fields: [fromBedId], references: [id], onDelete: SetNull)
  toBed         PGBed?     @relation("RoomChangeToBed", fields: [toBedId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([requesterId, status])
}

model PGExpense {
  id         String   @id @default(uuid())
  propertyId String
  category   String   @default("OTHER")
  amount     Float
  spentOn    DateTime
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, spentOn])
}

model PGElectricityBill {
  id          String   @id @default(uuid())
  propertyId  String
  period      String
  totalAmount Float
  imageUrl    String?
  status      String   @default("DRAFT")
  splitJson   String   @default("[]")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, period, status])
}

model OtpCode {
  id           String    @id @default(uuid())
  phone        String
  propertyId   String?
  purpose      String    @default("BOOKING")
  codeHash     String
  verifiedToken String?  @unique
  tokenExpiresAt DateTime?
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

model PHAuditLog {
  id         String   @id @default(uuid())
  propertyId String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
}

model ConversationSession {
  id        String   @id @default(uuid())
  userId    String?
  channel   String   @default("web")
  role      String   @default("RESIDENT")
  stateJson String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}
