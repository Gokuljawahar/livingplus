# LivingPlus Frontend Environment Variables
# Copy this file to .env (or .env.local) and fill in your public web app keys.
# Never commit real API keys or secrets to git.

# Backend API proxy target during `npm run dev`
VITE_PROXY_TARGET=http://localhost:4000

# Firebase Web App Configuration (Firebase Console -> Project Settings -> Your apps -> Web app)
# Note: Firebase web config values are public identifiers by design, never admin credentials.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase App Check (required for Firebase AI Logic in production)
# Create a reCAPTCHA v3 or reCAPTCHA Enterprise site key in Google Cloud / Firebase App Check.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# Set to "true" to use ReCaptchaEnterpriseProvider instead of ReCaptchaV3Provider
VITE_RECAPTCHA_ENTERPRISE=false
# Set to "true" in local dev (prints a debug token in the browser console to register in Firebase Console),
# or paste a pre-registered App Check debug token UUID for judges / CI.
VITE_APPCHECK_DEBUG=true

# Firebase AI Logic Cloud Fallback Model
# Used when on-device Gemini Nano is unavailable or InferenceMode is ONLY_IN_CLOUD / PREFER_IN_CLOUD
VITE_GEMINI_CLOUD_MODEL=gemini-2.5-flash

# Optional: Google Maps JavaScript API key for interactive location picker
VITE_GOOGLE_MAPS_API_KEY=
