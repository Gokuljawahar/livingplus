generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  slug         String?  @unique
  email      String?  @unique
  phone      String?  @unique
  password   String
  name       String
  /// Set when the owner proved the phone number with a code (shown to guests as "Verified owner").
  phoneVerifiedAt DateTime?
  role       String   @default("PG_OWNER")
  profileImage String?
  // Google account linked by the user after a password sign-in (Firebase uid).
  // Google sign-in matches this id, never the email typed at registration.
  googleUid      String?   @unique
  googleLinkedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pgAccess   PGPropertyAccess[]
}

model PGProperty {
  id           String   @id @default(uuid())
  slug         String?  @unique
  name         String
  description  String?
  address      String
  locality     String
  contactPhone String?
  landmark     String?
  city         String   @default("Chennai")
  pincode      String?
  latitude     Float?
  longitude    Float?
  genderPolicy String   @default("ANY")
  propertyType String   @default("PG")
  tagline      String?
  amenities    Json     @default("[]")
  highlights   Json     @default("[]")
  foodDetails  String?
  nearbyPlaces Json     @default("[]")
  houseRules   Json     @default("[]")
  photoUrls    Json     @default("[]")
  status       String   @default("ACTIVE")
  featured     Boolean  @default(false)
  onboardedByAdmin Boolean @default(false)
  bookingLockMinutes Int @default(120)
  rentDay      Int      @default(1)
  rentDueDay   Int      @default(5)
  // Semantic search index (see services/semantic-search.ts).
  searchEmbedding      Float[]   @default([])
  searchEmbeddingModel String?
  searchTextHash       String?
  searchIndexedAt      DateTime?
  upiId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms              PGRoom[]
  access             PGPropertyAccess[]
  bookings           PGBooking[]
  tenants            PGTenant[]
  auditLogs          PHAuditLog[]
  maintenanceTickets PGMaintenanceTicket[]
  expenses           PGExpense[]
  electricityBills   PGElectricityBill[]
  paymentClaims      PGPaymentClaim[]
  residentNotifications PGResidentNotification[]
  roomChangeRequests PGRoomChangeRequest[]
  /// Optional services switched on by the owner (see @livingplus/shared services). Null = defaults.
  serviceSettings Json?
  serviceOrders PGServiceOrder[]
  conditionReports PGConditionReport[]
}

model PGPropertyAccess {
  id         String     @id @default(uuid())
  propertyId String
  userId     String
  role       String     @default("OWNER")
  createdAt  DateTime   @default(now())
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId, role])
}

model PGRoom {
  id                 String     @id @default(uuid())
  propertyId         String
  block              String?
  roomNumber         String
  floor              Int?
  roomType           String     @default("SHARED")
  monthlyRent        Float
  depositAmount      Float      @default(0)
  maintenanceFee     Float      @default(0)
  utilitiesSurcharge Float      @default(0)
  hasAc              Boolean    @default(false)
  foodIncluded       Boolean    @default(false)
  foodCharge         Float      @default(0)
  description        String?
  amenities          Json       @default("[]")
  photoUrls          Json       @default("[]")
  status             String     @default("ACTIVE")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  property           PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds               PGBed[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, status])
}

model PGBed {
  id              String   @id @default(uuid())
  /// Workspace key, set by a database trigger from the room (see the tenant_isolation migration).
  propertyId      String   @default(dbgenerated("''"))
  roomId          String
  label           String
  status          String   @default("AVAILABLE")
  maintenanceNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  room            PGRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings        PGBooking[]
  tenants         PGTenant[]
  roomChangeFrom  PGRoomChangeRequest[] @relation("RoomChangeFromBed")
  roomChangeTo    PGRoomChangeRequest[] @relation("RoomChangeToBed")

  @@unique([roomId, label])
  @@index([roomId, status])
  @@index([propertyId])
}

model PGBooking {
  id            String     @id @default(uuid())
  bookingRef    String?    @unique
  propertyId    String
  bedId         String?
  residentName  String
  phone         String
  email         String?
  moveInDate    DateTime
  moveOutDate   DateTime?
  lockExpiresAt DateTime?
  status        String     @default("PENDING")
  notes         String?
  /// VibeCheck answers given with the request; copied to the resident on approval.
  vibeAnswers   Json?
  /// VibeCheck habit summary given with the request; copied to the resident on approval.
  vibeSummary   String?
  rejectionReason String?
  idempotencyKey String? @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  property      PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bed           PGBed?     @relation(fields: [bedId], references: [id], onDelete: SetNull)
  tenant        PGTenant?

  @@index([propertyId, status, createdAt])
  @@index([bedId, status])
}

model PGTenant {
  id                    String       @id @default(uuid())
  propertyId            String
  bedId                 String?
  bookingId             String?      @unique
  name                  String
  phone                 String
  email                 String?
  permanentAddress      String?
  bloodGroup            String?
  institutionOrEmployer String?
  emergencyName         String?
  emergencyPhone        String?
  kycType               String?
  kycDocumentUrl        String?
  kycVerified           Boolean    @default(false)
  kycVerifiedAt         DateTime?
  foodOptOut            Boolean    @default(false)
  /// VibeCheck lifestyle answers (see @livingplus/shared vibecheck): { questionId: 0 | 1 | 2 }
  vibeAnswers           Json?
  /// VibeCheck habits in the resident's own words (written by the profile agent, reviewed by them).
  vibeSummary           String?
  /// AI reading of the KYC document (type, name match, last 4 digits, flags). Never the full ID number.
  kycAiCheck            Json?
  noticeDate            DateTime?
  moveInDate            DateTime
  moveOutDate           DateTime?
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  monthlyRent           Float
  depositAmount         Float        @default(0)
  depositReceived       Float        @default(0)
  depositDeductions     Float        @default(0)
  depositRefundAmount   Float?
  depositRefundStatus   String       @default("NOT_APPLICABLE")
  depositRefundReference String?
  depositRefundedAt     DateTime?
  checkoutNote          String?
  status                String       @default("RESERVED")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  property              PGProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bed                   PGBed?       @relation(fields: [bedId], references: [id], onDelete: SetNull)
  booking               PGBooking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rentEntries           PGRentEntry[]
  conditionReports      PGConditionReport[]
  serviceOrders         PGServiceOrder[]
  maintenanceTickets    PGMaintenanceTicket[]
  paymentClaims         PGPaymentClaim[]
  notifications         PGResidentNotification[]
  roomChangeRequests  PGRoomChangeRequest[] @relation("RoomChangeRequester")
  roomChangePartners  PGRoomChangeRequest[] @relation("RoomChangePartner")

  @@index([propertyId, status])
}

model PGRentEntry {
  id          String   @id @default(uuid())
  /// Workspace key, set by a database trigger from the resident (see the tenant_isolation migration).
  propertyId  String   @default(dbgenerated("''"))
  tenantId    String
  entryType   String   @default("RENT")
  period      String
  amount      Float
  paidAmount  Float    @default(0)
  dueDate     DateTime
  paidAt      DateTime?
  status      String   @default("DUE")
  reference   String?
  method      String?
  notes       String?
  invoiceCode String?  @unique
  lastReminderAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      PGTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentClaims PGPaymentClaim[]

  @@unique([tenantId, period, entryType])
  @@index([period, status])
  @@index([propertyId, period])
}

model PGMaintenanceTicket {
  id          String     @id @default(uuid())
  propertyId  String
  bedId       String?
  tenantId    String?
  title       String
  description String
  category    String     @default("OTHER")
  priority    String     @default("NORMAL")
  status      String     @default("OPEN")
  imageUrl    String?
  assignedTo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  property    PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      PGTenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([propertyId, status, priority])
}

model PGPaymentClaim {
  id            String      @id @default(uuid())
  propertyId    String
  tenantId      String
  rentEntryId   String
  amount        Float
  reference     String
  status        String      @default("PENDING")
  reviewedBy    String?
  reviewedAt    DateTime?
  responseNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  property      PGProperty  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        PGTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentEntry     PGRentEntry @relation(fields: [rentEntryId], references: [id], onDelete: Cascade)

  @@unique([propertyId, reference])
  @@index([propertyId, status, createdAt])
  @@index([tenantId, status])
}

model PGResidentNotification {
  id         String     @id @default(uuid())
  propertyId String
  tenantId   String
  type       String
  title      String
  message    String
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime   @default(now())
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     PGTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt, createdAt])
  @@index([propertyId, type, createdAt])
}

model PGRoomChangeRequest {
  id            String   @id @default(uuid())
  propertyId    String
  requesterId   String
  requestType   String   @default("SWAP")
  fromBedId     String?
  toBedId       String?
  partnerId     String?
  preferences   String?
  reason        String?
  status        String   @default("PENDING_MATCH")
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  property      PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requester     PGTenant   @relation("RoomChangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  partner       PGTenant?  @relation("RoomChangePartner", fields: [partnerId], references: [id], onDelete: SetNull)
  fromBed       PGBed?     @relation("RoomChangeFromBed", fields: [fromBedId], references: [id], onDelete: SetNull)
  toBed         PGBed?     @relation("RoomChangeToBed", fields: [toBedId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([requesterId, status])
}

model PGExpense {
  id         String   @id @default(uuid())
  propertyId String
  category   String   @default("OTHER")
  amount     Float
  spentOn    DateTime
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, spentOn])
}

model PGElectricityBill {
  id          String   @id @default(uuid())
  propertyId  String
  period      String
  totalAmount Float
  imageUrl    String?
  status      String   @default("DRAFT")
  splitJson   String   @default("[]")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, period, status])
}

model OtpCode {
  id           String    @id @default(uuid())
  phone        String
  propertyId   String?
  purpose      String    @default("BOOKING")
  codeHash     String
  verifiedToken String?  @unique
  tokenExpiresAt DateTime?
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

model PHAuditLog {
  id         String   @id @default(uuid())
  propertyId String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
}

model ConversationSession {
  id        String   @id @default(uuid())
  userId    String?
  channel   String   @default("web")
  role      String   @default("RESIDENT")
  stateJson String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Timestamped room condition at move-in or move-out (notes + photos). Append-only:
/// the database allows adding and reading, never editing or deleting (tenant_isolation policies).
model PGConditionReport {
  id          String     @id @default(uuid())
  propertyId  String
  tenantId    String
  kind        String     /// MOVE_IN | MOVE_OUT
  notes       String?
  photoUrls   String[]
  createdBy   String?
  createdByRole String?
  createdAt   DateTime   @default(now())
  property    PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      PGTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([propertyId])
}

/// A resident's meal or housekeeping order for a date and slot (services switched on per PG).
model PGServiceOrder {
  id         String     @id @default(uuid())
  propertyId String
  tenantId   String
  type       String     /// MEAL | HOUSEKEEPING
  forDate    DateTime   @db.Date
  slot       String     /// BREAKFAST | LUNCH | DINNER, or MORNING | AFTERNOON | EVENING
  quantity   Int        @default(1)
  unitPrice  Float      @default(0)
  notes      String?
  status     String     @default("REQUESTED") /// REQUESTED | CONFIRMED | DONE | CANCELLED
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  property   PGProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     PGTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId, forDate])
  @@index([tenantId, forDate])
}

/// Incoming inquiry from a PG owner on the landing page ("List Your PG").
/// Managed in the internal concierge onboarding console (/admin) before publishing.
model OwnerLead {
  id                  String   @id @default(uuid())
  ownerName           String
  phone               String
  email               String?
  propertyName        String
  city                String   @default("Chennai")
  locality            String
  address             String?
  propertyType        String   @default("PG")
  genderPolicy        String   @default("ANY")
  propertyCount       Int      @default(1)
  totalRooms          Int?
  totalBeds           Int?
  startingRent        Float?
  amenities           Json     @default("[]")
  notes               String?
  status              String   @default("NEW")
  internalNotes       String?
  onboardedPropertyId String?
  onboardedOwnerId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

/// Dynamic platform-wide configuration and domain catalogs (amenities, room amenities,
/// landmarks, property types, room types, price bands, VibeCheck questions, KYC types,
/// expense & maintenance categories, payment methods, meal/cleaning slots, assistant copy).
/// Provisioned automatically into PostgreSQL on startup and editable via `/admin/catalog`.
model PlatformCatalog {
  key         String   @id
  description String?
  data        Json
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

