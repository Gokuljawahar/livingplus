# PostgreSQL. Port 5433 on localhost = the bundled local server `npm run dev` starts.
# On Google Cloud use Cloud SQL, e.g. postgresql://USER:PASS@/livingplus?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://livingplus:livingplus@localhost:5433/livingplus"
PORT=4000
LIVINGPLUS_ROOT_DOMAIN="livingplus.com"
FRONTEND_URL="http://localhost"
# Production requires a unique random value of at least 32 bytes.
JWT_SECRET=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# File storage: "local" (development), "gcs" (Google Cloud Storage) or "s3".
UPLOAD_STORAGE="local"
# local: defaults to backend/private-uploads; set a persistent path for deployments.
UPLOAD_DIR=""
# gcs: bucket name; credentials come from Google ADC (the Cloud Run service account).
GCS_BUCKET=""
# Set when the API is behind a reverse proxy or served from another public origin.
PUBLIC_API_URL=""

# Optional modules (default off). Platform works offline without them:
# WhatsApp Tier 1 is wa.me click-to-chat using each property's contactPhone.
ENABLE_WHATSAPP_CLOUD_API=false
ENABLE_UPI_PAYMENT=false

# Required only when ENABLE_WHATSAPP_CLOUD_API=true (Meta Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERSION="v21.0"

# Required only when ENABLE_UPI_PAYMENT=true (Razorpay/Cashfree keys)
UPI_GATEWAY_KEY_ID=""
UPI_GATEWAY_KEY_SECRET=""

# AI assistant (LangChain + LangGraph agent). Provider-agnostic: pick any model
# with AI_MODEL="<provider>:<model>" and give that provider its usual credentials.
#   google:gemini-3.8-flash      -> GOOGLE_API_KEY from https://aistudio.google.com/apikey
#                                  (no key = Vertex AI via Google Cloud ADC, e.g. on Cloud Run)
#   openai:<model>               -> npm i @langchain/openai, OPENAI_API_KEY
#   anthropic:<model>            -> npm i @langchain/anthropic, ANTHROPIC_API_KEY
#   ollama:<model>               -> npm i @langchain/ollama (local models, no key)
ENABLE_AI_ORCHESTRATOR=false
AI_MODEL="google:gemini-3.8-flash"
GOOGLE_API_KEY=""
# Optional: audio-capable model for voice notes (defaults to AI_MODEL)
AI_VOICE_MODEL=""
# Optional: JSON of provider options passed to the model, e.g.
# {"temperature":0.2} or, for Vertex AI, {"platformType":"gcp","location":"us-central1"}
AI_MODEL_OPTIONS=""
# Optional: model call timeout in ms (default 30000)
MODEL_API_TIMEOUT_MS="30000"

# Business timezone for rent periods, due dates and monthly jobs.
APP_TIMEZONE="Asia/Kolkata"

# Scheduled jobs. "internal" runs timers in the API process (development).
# "external": trigger POST /internal/cron/monthly-rent and /internal/cron/rent-reminders
# from Google Cloud Scheduler instead (required on Cloud Run).
SCHEDULER_MODE="internal"
# Cloud Scheduler OIDC: the audience configured on the job (usually the API URL)
# and the service account it signs as.
CRON_OIDC_AUDIENCE=""
CRON_SERVICE_ACCOUNT=""
# Alternative for local testing or other crons: a shared bearer secret.
CRON_SECRET=""

# Logging: JSON for Cloud Logging by default; LOG_FORMAT=pretty for readable local logs.
LOG_LEVEL="info"
LOG_FORMAT=""
# Proxies to trust for the client IP. Default: 1 on Cloud Run (K_SERVICE set), loopback otherwise.
TRUST_PROXY=""
# Extra browser origins allowed by CORS, comma-separated; "*" matches one subdomain label.
# https://LIVINGPLUS_ROOT_DOMAIN, its subdomains and FRONTEND_URL are always allowed,
# and localhost origins outside production.
CORS_ORIGINS=""
# AI chat and voice requests per caller per minute (default 20).
AI_RATE_LIMIT_PER_MINUTE=""

# Phone OTP provider: "sms" (API sends codes via SMS_API_URL; demo codes in development)
# or "firebase" (Firebase Phone Auth sends and checks codes; no SMS provider needed).
OTP_PROVIDER="sms"
# Firebase project for OTP_PROVIDER=firebase (Firebase console > Project settings > Your apps > Web).
# These are public web-app values, not secrets.
FIREBASE_PROJECT_ID=""
FIREBASE_WEB_API_KEY=""
FIREBASE_APP_ID=""
# Optional: defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=""

# Semantic PG search: listings embedded with AI_EMBEDDING_MODEL, queries ranked by meaning.
ENABLE_SEMANTIC_SEARCH=false
# "<provider>:<model>": google-genai uses GOOGLE_API_KEY; others need their @langchain package.
AI_EMBEDDING_MODEL="google-genai:gemini-embedding-001"
# Optional JSON provider options (google-genai defaults to {"outputDimensionality":768}).
AI_EMBEDDING_OPTIONS=""
# Minimum similarity (0-1) for a meaning-only match; keyword matches always show.
SEMANTIC_SEARCH_MIN_SCORE="0.6"
SEARCH_RATE_LIMIT_PER_MINUTE=""
