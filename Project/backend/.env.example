DATABASE_URL="file:../database.db"
PORT=4000
FRONTEND_URL="http://localhost"
# Production requires a unique random value of at least 32 bytes.
JWT_SECRET=""

# Optional modules (default off). Platform works offline without them:
# WhatsApp Tier 1 is wa.me click-to-chat using each property's contactPhone.
ENABLE_WHATSAPP_CLOUD_API=false
ENABLE_UPI_PAYMENT=false

# Required only when ENABLE_WHATSAPP_CLOUD_API=true (Meta Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERSION="v21.0"

# Required only when ENABLE_UPI_PAYMENT=true (Razorpay/Cashfree keys)
UPI_GATEWAY_KEY_ID=""
UPI_GATEWAY_KEY_SECRET=""

# AI orchestrator (PG OS agentic layer). Copy these into .env and fill the key.
ENABLE_AI_ORCHESTRATOR=false
META_MODEL_API_KEY=""
META_MODEL_BASE_URL="https://api.meta.ai/v1"
META_MODEL_NAME="muse-spark-1.3"
# Optional: model call timeout in ms (default 30000)
MODEL_API_TIMEOUT_MS="30000"
# Optional: voice transcription model (default muse-voice-transcribe-1.0)
META_VOICE_MODEL_NAME="muse-voice-transcribe-1.0"
